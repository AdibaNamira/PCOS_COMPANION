# Copy this file to ".env" (same folder) and fill in your real key.
# Never commit the real .env file anywhere public — it contains your secret key.

OPENROUTER_API_KEY=your_actual_openrouter_key_here

# Current recommended free model as of Aug 2026. Free model IDs on
# OpenRouter change over time - if this one stops working, check
# https://openrouter.ai/models?max_price=0 for a current free model ID
# and paste it here instead. No code changes needed.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
